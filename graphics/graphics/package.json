{
  "name": "charts-for-diplom",
  "version": "1.0.1",
  "description": "Компоненты и утилиты для графиков (Vue / ECharts)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "echarts",
    "charts"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=charts-for-diplom-example",
    "dev:backend": "npm run free-port:5000 && dotnet run --project \"data-service/DataService.csproj\"",
    "free-port:5000": "node scripts/free-port.mjs 5000",
    "build": "npm run build --workspace=charts-for-diplom-example",
    "generate": "npm run generate --workspace=charts-for-diplom-example",
    "preview": "npm run preview --workspace=charts-for-diplom-example"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "moment-timezone": "^0.6.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    },
    "echarts": {
      "optional": false
    },
    "moment-timezone": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
