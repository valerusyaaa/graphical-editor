# Опционально: SSE от backend-адаптера. Без переменной — без сетевых запросов.
# Локальный поток без установки RabbitMQ (мок в demo/vite.config.ts):
# VITE_SSE_URL=/api/dev/sse-mock
#
# Когда появится стенд, подставьте выданный бэкендом URL, например:
# VITE_SSE_URL=https://adapter.company.example/v1/schemes/current/events

# --- Два фронта на одном ПК (у вас и у Полины оба :5173) ---
# Запустите своё демо на другом порту, например 5174:
# VITE_DEMO_PORT=5174

# --- Метамодель (API ветки, GET content) ---
# Прокси Vite: `/mm-proxy/...` → VITE_METAMODEL_PROXY_TARGET (префикс снимается).
# По умолчанию в vite.config.ts: http://100.77.240.66:5233 (Tailscale desktop-polina).
# VITE_METAMODEL_PROXY_TARGET=http://100.77.240.66:5233
# Экспорт ветки main (при старте редактора, без переменной — тот же путь через /mm-proxy):
# VITE_METAMODEL_TYPES_URL=/mm-proxy/api/Branches/b7100fa2-3f36-4f34-aaaa-948a65356b94/content
#
# Если бэкенд отдаёт CORS, можно указать полный URL без прокси:
# VITE_METAMODEL_TYPES_URL=http://100.77.240.66:5233/api/Branches/b7100fa2-3f36-4f34-aaaa-948a65356b94/content

# --- Сервис предметной области (GET/POST /api/schemes) ---
# Тело POST: { name, description, Data } — SchemeRequestDto (EditedJSON в Data). Порт 5085.
# VITE_DOMAIN_SCHEME_SCHEMA_KEY=Data
# Прокси: `/domain-proxy/api/schemes` → VITE_DOMAIN_SERVICE_PROXY_TARGET
# Бэкенд на этом ПК:
# VITE_DOMAIN_SERVICE_PROXY_TARGET=http://127.0.0.1:5085
# Бэкенд через Tailscale:
# VITE_DOMAIN_SERVICE_PROXY_TARGET=http://100.99.86.95:5085
# Бэкенд на ПК в локальной Wi‑Fi:
# VITE_DOMAIN_SERVICE_PROXY_TARGET=http://192.168.0.114:5085
# VITE_DOMAIN_SCHEME_API_URL=/domain-proxy/api/schemes
# VITE_DOMAIN_SCHEME_CREATE_URL=/domain-proxy/api/schemes
# VITE_DOMAIN_SCHEME_LIST_URL=/domain-proxy/api/schemes
# VITE_DOMAIN_SCHEME_GET_BY_ID_URL=/domain-proxy/api/schemes/{schemeId}
# VITE_DOMAIN_SCHEME_GET_BY_NAME_URL=/domain-proxy/api/schemes/by-name/{name}
# Если бэкенд ждёт Data как строку JSON (как DataJson в БД):
# VITE_DOMAIN_SCHEME_SCHEMA_AS_STRING=true
# POST EditedJSON для расчёта: /domain-proxy/api/schemes/raw
# VITE_DOMAIN_SCHEME_RAW_URL=/domain-proxy/api/schemes/raw
# PUT при изменении схемы: /domain-proxy/api/schemes/{schemeId}
# VITE_DOMAIN_SCHEME_RAW_UPDATE_URL=/domain-proxy/api/schemes/{schemeId}
# Расчёт CalculationService (5041): POST /api/calculations/static?schemeId={uuid}
# VITE_CALCULATION_SERVICE_PROXY_TARGET=http://100.99.86.95:5041
# VITE_CALCULATION_URL=/calc-proxy/api/calculations/static?schemeId={schemeId}
